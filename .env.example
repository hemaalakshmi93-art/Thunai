# --- Core ---
PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL of the deployed app (used in email links)
APP_URL=http://localhost:8080

# --- Storage ---
# "file" (default, local dev) or "firestore" (production on Cloud Run)
STORE=file
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# --- Email reminders (any SMTP; for Gmail use an App Password) ---
# Leave blank to run in simulation mode (emails are shown in the in-app Outbox).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Thunai Care <you@gmail.com>"

# --- Gemini (Smart Add + weekly story). Optional; falls back to rule-based parsing ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Reminders ---
# Shared secret that Cloud Scheduler sends in the x-cron-secret header
CRON_SECRET=change-me-too
# Run the reminder loop inside the process too (use with Cloud Run min-instances=1)
INTERNAL_TICK=false
